// use prisma-8


model User {
  id          String     @id @onCreate(uuid())
  clerkUserId String     @unique
  email       String     @unique
  createdAt   DateTime   @default(now())
  role        String    @default("USER")
  contracts   Contract[]
}

model MainContract {
  id            String   @id @onCreate(uuid())
  fileName      String
  filePath      String
  fileSize      Int
  extractedText String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}


model Contract {
  id            String   @id @onCreate(uuid())
  userId        String
  fileName      String
  filePath      String
  fileSize      Int
  extractedText String?
  status        String   @default("processing")
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
  reviews       Review[]
  messages      ChatMessage[]
}


model Review {
  id             String   @id @onCreate(uuid())
  contractId     String
  mainContractId String
  createdAt      DateTime @default(now())

  contract       Contract       @relation(fields: [contractId], references: [id])
  findings       ReviewFinding[]
}

model ReviewFinding {
  id                  String   @id @onCreate(uuid())
  reviewId            String
  checklistItem       String

  // User contract findings
  status              String
  referenceStatus     String
  summary             String
  quote               String?
  fullClause          String?
  pageNumber          Int?
  sectionName         String?

  // Main Contract reference findings
  referenceSummary    String?
  referenceQuote      String?
  referenceFullClause String?
  referencePageNumber Int?
  referenceSection    String?

  // Comparison result
  matchStatus         String

  review              Review   @relation(fields: [reviewId], references: [id])
}

model ChatMessage {
  id          String   @id @onCreate(uuid())
  contractId  String
  role        String
  content     String
  createdAt   DateTime @default(now())

  contract    Contract @relation(fields: [contractId], references: [id])
}